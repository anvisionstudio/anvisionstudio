root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md,dist,example}]
indent_style = space
indent_size = 2

[*.{js,jsx,ts,tsx,scss,css}]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{html,xml}]
indent_style = tab
indent_size = 4
