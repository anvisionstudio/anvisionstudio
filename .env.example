# Copy to .env and fill in values. Never commit .env.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=anvisionstudio
HOST_UID=1000
HOST_GID=1000

# ---------------------------------------------------------------------------
# Published ports (host)
# ---------------------------------------------------------------------------
WP_PORT=8080
ADMINER_PORT=8081
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---------------------------------------------------------------------------
# Database — replace placeholders before first boot
# ---------------------------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_HOST=db
TABLE_PREFIX=wp_

# ---------------------------------------------------------------------------
# WordPress — used by `make setup` / scripts/install-wordpress.sh
# ---------------------------------------------------------------------------
WP_URL=http://localhost:8080
WP_TITLE=Anvision Studio
WP_ADMIN_USER=replace-with-admin-username
WP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
WP_ADMIN_EMAIL=dev@example.test
WP_LOCALE=zh_TW

# ---------------------------------------------------------------------------
# Xdebug (set XDEBUG_MODE=off to disable)
# ---------------------------------------------------------------------------
XDEBUG_MODE=debug,develop
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

# ---------------------------------------------------------------------------
# Mailpit (WordPress SMTP is wired via mu-plugin)
# ---------------------------------------------------------------------------
MAILPIT_SMTP_HOST=mailpit
MAILPIT_INTERNAL_SMTP_PORT=1025
