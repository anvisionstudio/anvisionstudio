{
  "name": "anvisionstudio",
  "private": true,
  "description": "Anvision Studio WordPress workspace",
  "workspaces": [
    "wp-content/themes/anvisionstudio",
    "wp-content/plugins/anvisionstudio-core"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@anvisionstudio/theme",
    "lint:js": "npm run lint:js --workspaces --if-present",
    "lint:css": "npm run lint:css --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
