{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        { "slug": "ink", "color": "#111111", "name": "Ink" },
        { "slug": "paper", "color": "#f7f4ef", "name": "Paper" },
        { "slug": "accent", "color": "#1f4d3a", "name": "Accent" },
        { "slug": "muted", "color": "#6b6b6b", "name": "Muted" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "1.0625rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        }
      },
      "heading": {
        "typography": {
          "lineHeight": "1.2"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
